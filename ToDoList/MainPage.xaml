<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ToDoList.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry x:Name="TituloEntry" Placeholder="Título"/>

            <Entry x:Name="DescripcionEntry" Placeholder="Descripción"/>

            <DatePicker x:Name="FechaVencimientoPicker"/>

            <Picker x:Name="EstadoPicker" Title="Estado">
                <Picker.Items>
                    <x:String>Pendiente</x:String>
                    <x:String>Completada</x:String>
                </Picker.Items>
            </Picker>

            <Picker x:Name="CategoriaPicker" Title="Categoría">
                <Picker.Items>
                    <x:String>Trabajo</x:String>
                    <x:String>Hogar</x:String>
                    <x:String>Personal</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Agregar Tarea" Clicked="OnAgregarTareaClicked"/>
            <Button Text="Eliminar Tarea" Clicked="OnEliminarTareaClicked"/>

            <CollectionView x:Name="TareasListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="5">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}" FontAttributes="Bold"/>
                                <Label Text="{Binding Descripcion}"/>
                                <Label Text="{Binding FechaVencimiento}"/>
                                <Label Text="{Binding Estado}"/>
                                <Label Text="{Binding Categoria}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>