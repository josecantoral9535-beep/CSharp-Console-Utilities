<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VehiculosApp.MainPage">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Entry x:Name="MarcaEntry" Placeholder="Marca"/>
        <Entry x:Name="ModeloEntry" Placeholder="Modelo"/>

        <Picker x:Name="TipoVehiculoPicker" Title="Tipo de vehículo">
            <Picker.Items>
                <x:String>Auto</x:String>
                <x:String>Moto</x:String>
                <x:String>Camión</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Agregar Vehículo" Clicked="OnAgregarVehiculo"/>

        <CollectionView x:Name="VehiculosList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Black" Padding="10" Margin="5">
                        <Label Text="{Binding}" TextColor="White" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>